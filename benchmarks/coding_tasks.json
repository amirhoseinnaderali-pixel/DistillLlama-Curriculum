{
  "version": "1.0",
  "tasks": [
    {
      "id": "p01",
      "problem": "Read one line containing a string. Print the string reversed.",
      "tests": [
        {
          "input": "hello\n",
          "expected_output": "olleh"
        },
        {
          "input": "abc123\n",
          "expected_output": "321cba"
        }
      ]
    },
    {
      "id": "p02",
      "problem": "Read n, then n integers. Print the second-largest distinct integer. Assume at least two distinct values exist.",
      "tests": [
        {
          "input": "5\n1 5 3 5 2\n",
          "expected_output": "3"
        },
        {
          "input": "6\n10 10 9 8 8 7\n",
          "expected_output": "9"
        },
        {
          "input": "5\n-1 -5 -1 -2 -3\n",
          "expected_output": "-2"
        }
      ]
    },
    {
      "id": "p03",
      "problem": "Read one line containing lowercase English letters. Print True if it is a palindrome after ignoring spaces; otherwise print False.",
      "tests": [
        {
          "input": "racecar\n",
          "expected_output": "True"
        },
        {
          "input": "never odd or even\n",
          "expected_output": "True"
        },
        {
          "input": "hello world\n",
          "expected_output": "False"
        }
      ]
    },
    {
      "id": "p04",
      "problem": "Read n followed by n intervals l r. Merge overlapping or touching intervals and print the merged intervals, one per line, sorted by left endpoint.",
      "tests": [
        {
          "input": "4\n1 3\n2 6\n8 10\n9 12\n",
          "expected_output": "1 6\n8 12"
        },
        {
          "input": "5\n0 2\n2 4\n10 12\n11 15\n20 21\n",
          "expected_output": "0 4\n10 15\n20 21"
        }
      ]
    },
    {
      "id": "p05",
      "problem": "Read integer n and print the sum of all primes p with 2 <= p <= n. Print 0 when n < 2.",
      "tests": [
        {
          "input": "10\n",
          "expected_output": "17"
        },
        {
          "input": "20\n",
          "expected_output": "77"
        },
        {
          "input": "1\n",
          "expected_output": "0"
        }
      ]
    },
    {
      "id": "p06",
      "problem": "Read r and c followed by an r by c integer matrix. Print its transpose.",
      "tests": [
        {
          "input": "2 3\n1 2 3\n4 5 6\n",
          "expected_output": "1 4\n2 5\n3 6"
        },
        {
          "input": "3 1\n5\n6\n7\n",
          "expected_output": "5 6 7"
        }
      ]
    },
    {
      "id": "p07",
      "problem": "Read a line containing lowercase letters and spaces. Print the most frequent letter and its count separated by a space. Ignore spaces and break ties alphabetically.",
      "tests": [
        {
          "input": "banana\n",
          "expected_output": "a 3"
        },
        {
          "input": "mississippi\n",
          "expected_output": "i 4"
        },
        {
          "input": "ab cab\n",
          "expected_output": "a 2"
        }
      ]
    },
    {
      "id": "p08",
      "problem": "Read n and m, then n undirected edges u v of a graph with vertices 1..n, then read start and target. Print the length of the shortest path using BFS; print -1 if unreachable.",
      "tests": [
        {
          "input": "5 5\n1 2\n2 3\n3 5\n1 4\n4 5\n1 5\n",
          "expected_output": "2"
        },
        {
          "input": "4 1\n1 2\n1 4\n",
          "expected_output": "-1"
        }
      ]
    }
  ]
}